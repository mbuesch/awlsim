TYPE UDT 1
VERSION : 0.1
STRUCT
	VAR0_BOOL	: BOOL;
	VAR1_INT	: INT		:= 11;
	VAR2_ARR	: ARRAY [1 .. 4] OF BYTE;
END_STRUCT;
END_TYPE


DATA_BLOCK DB 1
STRUCT
	DBVAR0_UDT1	: UDT 1;
	DBVAR1_ARR	: ARRAY [1 .. 2] OF UDT 1;
END_STRUCT;
BEGIN
	DBVAR0_UDT1.VAR1_INT		:= 7;
	DBVAR0_UDT1.VAR2_ARR[2]		:= B#16#21;
	DBVAR1_ARR[2].VAR1_INT		:= 4;
	DBVAR1_ARR[1].VAR0_BOOL		:= TRUE;
END_DATA_BLOCK


ORGANIZATION_BLOCK OB 1
BEGIN
	// Start values of UDT members in a global DB
	L		DB1.DBVAR0_UDT1.VAR1_INT
	__ASSERT==	__ACCU 1,	7
	L		DB1.DBW 2
	__ASSERT==	__ACCU 1,	7
	L		DB1.DBVAR0_UDT1.VAR2_ARR[2]
	__ASSERT==	__ACCU 1,	B#16#21
	L		DB1.DBB 5
	__ASSERT==	__ACCU 1,	B#16#21

	// Start values of ARRAY OF UDT members in a global DB
	L		DB1.DBVAR1_ARR[1].VAR1_INT
	__ASSERT==	__ACCU 1,	11
	L		DB1.DBVAR1_ARR[2].VAR1_INT
	__ASSERT==	__ACCU 1,	4
	L		DB1.DBW 18
	__ASSERT==	__ACCU 1,	4
	U		DB1.DBVAR1_ARR[1].VAR0_BOOL
	__ASSERT==	__STW VKE,	1
	U		DB1.DBX 8.0
	__ASSERT==	__STW VKE,	1

	CALL SFC 46 // STOP CPU
END_ORGANIZATION_BLOCK
