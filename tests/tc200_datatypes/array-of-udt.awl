TYPE UDT 1
VERSION : 0.1
STRUCT
	VAR0_BOOL	: BOOL;
	VAR1_INT	: INT		:= 11;
	VAR2_ARR	: ARRAY [1 .. 4] OF BYTE;
END_STRUCT;
END_TYPE


DATA_BLOCK DB 1
STRUCT
	DBVAR0_BOOL	: BOOL;
	DBVAR1_ARR	: ARRAY [1 .. 2] OF UDT 1;
	DBVAR2_INT	: INT;
END_STRUCT;
BEGIN
	DBVAR2_INT	:= 99;
END_DATA_BLOCK


FUNCTION_BLOCK FB 1
VAR
	FBVAR0_BOOL	: BOOL;
	FBVAR1_ARR	: ARRAY [1 .. 2] OF UDT 1;
	FBVAR2_INT	: INT;
END_VAR
BEGIN
	// UDT default values in each element
	L		#FBVAR1_ARR[1].VAR1_INT
	__ASSERT==	__ACCU 1,	11
	L		#FBVAR1_ARR[2].VAR1_INT
	__ASSERT==	__ACCU 1,	11

	// Instance DB start values
	L		#FBVAR1_ARR[1].VAR2_ARR[3]
	__ASSERT==	__ACCU 1,	B#16#44
	L		#FBVAR2_INT
	__ASSERT==	__ACCU 1,	9

	// Element layout: 8 bytes per element, starting at DBB 2
	L		55
	T		#FBVAR1_ARR[2].VAR1_INT
	L		DIW 12
	__ASSERT==	__ACCU 1,	55
	L		DIB 8
	__ASSERT==	__ACCU 1,	B#16#44
	L		DIW 18
	__ASSERT==	__ACCU 1,	9
END_FUNCTION_BLOCK


DATA_BLOCK DB 2
	FB 1
BEGIN
	FBVAR1_ARR[1].VAR2_ARR[3]	:= B#16#44;
	FBVAR2_INT			:= 9;
END_DATA_BLOCK


ORGANIZATION_BLOCK OB 1
BEGIN
	// ARRAY OF UDT in a global DB
	L		DB1.DBVAR1_ARR[1].VAR1_INT
	__ASSERT==	__ACCU 1,	11
	L		123
	T		DB1.DBVAR1_ARR[2].VAR1_INT
	L		DB1.DBW 12
	__ASSERT==	__ACCU 1,	123
	L		DB1.DBVAR2_INT
	__ASSERT==	__ACCU 1,	99
	L		DB1.DBW 18
	__ASSERT==	__ACCU 1,	99

	// ARRAY OF UDT in an FB
	CALL	FB 1, DB 2

	CALL SFC 46 // STOP CPU
END_ORGANIZATION_BLOCK
