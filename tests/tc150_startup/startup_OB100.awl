ORGANIZATION_BLOCK OB 100
BEGIN
	// STW starts cleared
	L		STW
	__ASSERT==	__ACCU 1,	0

	// Set OB 100 has-executed flag.
	L		MD 0
	__ASSERT==	__ACCU 1,	0
	L		100
	T		MD 0

	// Zero main cycle counter.
	L		0
	T		MW 4

	// Leave STW bits set; OB 1 must not see them.
	SET
	SAVE
	L		1.0
	L		0.0
	/R
END_ORGANIZATION_BLOCK



ORGANIZATION_BLOCK OB 1
BEGIN
	// STW starts cleared
	L		STW
	__ASSERT==	__ACCU 1,	0

	// assert 4-accus
	__FEATURE	0
	__ASSERT==	__ACCU 1,	4

	// check that OB 100 was executed
	L		MD 0
	__ASSERT==	__ACCU 1,	100

	// Leave status bits set; the next cycle must not see them.
	SET
	SAVE
	L		1.0
	L		0.0
	/R

	// Stop after a couple of cycles.
	L		MW 4
	+		1
	T		MW 4
	L		3
	>=I
	SPBN		end
	CALL SFC 46 // STOP CPU
end:	NOP		0
END_ORGANIZATION_BLOCK
